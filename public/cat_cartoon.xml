<svg class="w-24 h-28 md:w-28 md:h-32 relative drop-shadow-[0_12px_24px_rgba(9,12,27,0.18)]" fill="none" viewBox="0 0 120 140" xmlns="http://www.w3.org/2000/svg">
<style>
          @keyframes tailSway { 0%, 100% { transform: rotate(0deg); } 50% { transform: rotate(18deg); } }
          @keyframes earLeftTwitch { 0%, 90%, 100% { transform: rotate(0deg); } 94% { transform: rotate(-8deg); } }
          @keyframes earRightTwitch { 0%, 85%, 100% { transform: rotate(0deg); } 90% { transform: rotate(10deg); } }
          @keyframes floatCat { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-7px); } }
          @keyframes blinkyEyes { 0%, 96%, 100% { transform: scaleY(1); } 98% { transform: scaleY(0.1); } }
          .cat-root { animation: floatCat 3.6s ease-in-out infinite; transform-origin: center bottom; }
          .cat-tail { animation: tailSway 2.4s ease-in-out infinite; transform-origin: 32px 115px; }
          .cat-ear-l { animation: earLeftTwitch 4s ease-in-out infinite; transform-origin: 40px 42px; }
          .cat-ear-r { animation: earRightTwitch 4.5s ease-in-out infinite; transform-origin: 80px 42px; }
          .cat-eyes { animation: blinkyEyes 5s ease-in-out infinite; transform-origin: center 58px; }
        </style>
<g class="cat-root"><!-- Animated Fluffy Tail -->
<g class="cat-tail">
<path d="M 32 110 C 18 108 8 92 12 76 C 14 68 24 64 28 72 C 30 78 22 84 22 92 C 22 98 28 104 34 106 Z" fill="#FF5C39"></path>
<circle cx="16" cy="72" fill="#FFB4A4" r="5"></circle>
</g>
<!-- Cat Body -->
<ellipse cx="60" cy="98" fill="#1F2232" rx="34" ry="32" class=""></ellipse>
<!-- Chest bib pattern -->
<path d="M 50 78 C 50 78 60 92 60 102 C 60 92 70 78 70 78 C 76 86 68 114 60 114 C 52 114 44 86 50 78 Z" fill="#FBF9F6" class=""></path>
<!-- Left Ear -->
<g class="cat-ear-l">
<polygon fill="#1F2232" points="34,48 24,18 52,36"></polygon>
<polygon fill="#FF5C39" points="34,44 28,24 48,36"></polygon>
</g>
<!-- Right Ear -->
<g class="cat-ear-r">
<polygon fill="#1F2232" points="86,48 96,18 68,36"></polygon>
<polygon fill="#FF5C39" points="86,44 92,24 72,36"></polygon>
</g>
<!-- Round Cat Head -->
<circle cx="60" cy="58" fill="#1F2232" r="32" class=""></circle>
<!-- Cheeks / Muzzle -->
<ellipse cx="52" cy="67" fill="#FBF9F6" rx="8" ry="6" class=""></ellipse>
<ellipse cx="68" cy="67" fill="#FBF9F6" rx="8" ry="6" class=""></ellipse>
<!-- Whiskers -->
<line stroke="#C7C5CD" stroke-linecap="round" stroke-width="1.8" x1="22" x2="44" y1="64" y2="66" class=""></line>
<line stroke="#C7C5CD" stroke-linecap="round" stroke-width="1.8" x1="20" x2="44" y1="71" y2="70" class=""></line>
<line stroke="#C7C5CD" stroke-linecap="round" stroke-width="1.8" x1="98" x2="76" y1="64" y2="66" class=""></line>
<line stroke="#C7C5CD" stroke-linecap="round" stroke-width="1.8" x1="100" x2="76" y1="71" y2="70" class=""></line>
<!-- Cute Triangle Nose -->
<polygon fill="#FF5C39" points="57,63 63,63 60,67" class=""></polygon>
<!-- Mouth line -->
<path d="M 56 67 Q 60 70 64 67" fill="none" stroke="#1F2232" stroke-linecap="round" stroke-width="1.5" class=""></path>
<!-- Big Expressive Eyes -->
<g class="cat-eyes">
<!-- Left Eye Socket -->
<ellipse cx="46" cy="53" fill="#FBF9F6" rx="9" ry="11"></ellipse>
<!-- Left Iris / Pupil (Responsive to mouse) -->
<ellipse cx="47" cy="53" fill="#FF5C39" id="pupilLeft" rx="5.5" ry="7.5"></ellipse>
<circle cx="44.5" cy="50" fill="#FFFFFF" id="glintLeft" r="2.5"></circle>
<circle cx="48" cy="55" fill="#FFFFFF" r="1.2"></circle>
<!-- Right Eye Socket -->
<ellipse cx="74" cy="53" fill="#FBF9F6" rx="9" ry="11"></ellipse>
<!-- Right Iris / Pupil (Responsive to mouse) -->
<ellipse cx="73" cy="53" fill="#FF5C39" id="pupilRight" rx="5.5" ry="7.5"></ellipse>
<circle cx="70.5" cy="50" fill="#FFFFFF" id="glintRight" r="2.5"></circle>
<circle cx="74" cy="55" fill="#FFFFFF" r="1.2"></circle>
</g>
<!-- Front Paws with 4 cute pink toe beans & central palm pads -->
<!-- Left Paw -->
<g class="cat-paw-left"><!-- Base Paw shape -->
  <ellipse cx="45" cy="116" fill="#FBF9F6" rx="11" ry="8"></ellipse>
  <!-- 4 Cute Pink Toe Beans along the top curve/arch -->
  <ellipse cx="37" cy="112.5" fill="#FF85A2" rx="1.7" ry="2.1" transform="rotate(-20 37 112.5)"></ellipse>
  <ellipse cx="41.5" cy="110" fill="#FF85A2" rx="1.8" ry="2.2" transform="rotate(-7 41.5 110)"></ellipse>
