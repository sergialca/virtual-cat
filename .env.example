# LiveKit Cloud credentials for /api/livekit/token.
# Leave all three unset for demo mode (mic + mock replies).
# Copy this file to .env (gitignored). Next.js reads .env and .env.local at startup — restart `pnpm dev` after edits.
# Do not commit real keys. A key/secret that does not belong to this project is rejected as "invalid token".
#
# From the project: LiveKit Cloud → Settings → Keys.
# https://docs.livekit.io/agents/server/startup-modes/
# The CLI can write the same three values: `lk app env -w`
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Dispatch name. Must match agent_name on the deployed worker exactly (case and punctuation).
# With agent_name set, LiveKit does not auto-join rooms; this app puts the name in the access token.
# https://docs.livekit.io/agents/server/agent-dispatch/
# Local source default is virtual-cat in agent/main.py. A Cloud deploy from `lk agent init` may use a different name.
LIVEKIT_AGENT_NAME=virtual-cat
